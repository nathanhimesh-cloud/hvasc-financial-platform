# Copy to .env.local and adjust. None of these are required for `seed` mode.

# ── Data source ──────────────────────────────────────────────────────────────
# Where the app gets its figures:
#   feed → runtime store (uploads / ODBC push) → bundled snapshot.json (default)
#   seed → illustrative demo figures (no setup needed)
#   csv  → parse Practical report exports from REPORTS_DIR
#   odbc → live Firebird feed (pushed to the runtime store by scripts/odbc)
# DATA_SOURCE=feed

# CSV drop folder produced by the scheduled Practical export task.
# Reachable only over the Sophos VPN. For local dev, point at a sample folder.
# REPORTS_DIR=\\hvasc-ad02\Data Share\Sands Reports

# ── Production (Vercel) ──────────────────────────────────────────────────────
# Vercel Blob store token — auto-injected when you create a Blob store in the
# Vercel dashboard. Required in prod so in-app uploads / ODBC pushes persist
# (Vercel's filesystem is read-only).
# BLOB_READ_WRITE_TOKEN=

# Shared secret that gates /api/feed/upload and /api/feed/snapshot. Set the same
# value here and in scripts/odbc/06-push.ps1 so only the feed can push data.
# UPLOAD_PASSWORD=

# Canonical site URL, used for metadata/manifest. On Vercel this falls back to
# the project's production domain automatically; set explicitly for a custom one.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
