# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime uploaded feed (local dev)
.data

# ODBC feed — generated output, never commit live financial data or logs
/scripts/odbc/snapshot.json
/scripts/odbc/logs/
/scripts/odbc/discover*-output.txt
/scripts/odbc/push-response.json
/scripts/odbc/sync-cursor.json
/scripts/odbc/*-probe.txt
/scripts/odbc/module-probe.txt
/scripts/odbc/orders-probe.txt
/scripts/odbc/assets-po-ageing.txt
/scripts/odbc/fr-income-probe.txt
